<para><programlisting filename=".cpp"><codeline><highlight class="comment">//<sp/>Значення<sp/>за<sp/>замовчуванням<sp/>(можна<sp/>змінити<sp/>в<sp/>config)</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">m_lowerSkin<sp/>=<sp/>{0,<sp/>20,<sp/>70};<sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>H_min,<sp/>S_min,<sp/>V_min</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">m_upperSkin<sp/>=<sp/>{20,<sp/>255,<sp/>255};<sp/></highlight><highlight class="comment">//<sp/>H_max,<sp/>S_max,<sp/>V_max</highlight></codeline>
</programlisting> </para>
</sect3></sect2></sect1>
