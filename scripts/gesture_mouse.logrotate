# /etc/logrotate.d/gesture_mouse
# ─────────────────────────────────────────────────────────────────────────────
# Конфігурація logrotate для зовнішньої (часової) ротації логів GestureMouse.
#
# Використовується РАЗОМ з вбудованою ротацією за розміром (spdlog,
# rotating_file_sink_mt, 5 МБ, 10 файлів).
# Цей файл забезпечує добову архівацію та видалення старих логів.
#
# Встановлення: sudo cp gesture_mouse /etc/logrotate.d/
# ─────────────────────────────────────────────────────────────────────────────

/opt/gesture_mouse/logs/*.log {
    daily               # ротація щодня
    rotate 30           # зберігати 30 архівів
    compress            # стиснути gzip
    delaycompress       # стискати файл наступного циклу (не поточного)
    missingok           # не повідомляти про відсутній файл
    notifempty          # не ротувати порожній файл
    dateext             # додати дату до імені архіву
    dateformat _%Y%m%d
    copytruncate        # скопіювати файл, потім очистити (без зупинки процесу)
}
